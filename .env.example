# Cổng chạy server
PORT=3000

# Key để client gọi vào server của bạn (header: x-api-key hoặc Authorization: Bearer ...)
# Để trống = không cần key (chỉ nên dùng khi chạy trên máy cá nhân)
SERVER_API_KEY=

# Google Sheet
SPREADSHEET_ID=
GOOGLE_CREDENTIALS_FILE=./credentials/service-account.json
SHEET_API_NAME=API
SHEET_LOG_NAME=LOG

# Bao lâu đọc lại danh sách API từ sheet (giây)
PROVIDER_REFRESH_SEC=60

# Chiến lược chọn mặc định: random | weighted | roundrobin
DEFAULT_STRATEGY=weighted

# Số lần thử tối đa (thử provider khác khi lỗi)
MAX_ATTEMPTS=3

# Timeout mặc định mỗi lần gọi (ms)
DEFAULT_TIMEOUT_MS=30000

# Circuit breaker: lỗi liên tiếp bao nhiêu lần thì tạm loại provider, trong bao lâu (giây)
FAIL_THRESHOLD=3
COOLDOWN_SEC=120

# Ghi log vào sheet: gom log và ghi mỗi X giây (tránh vượt quota Google)
LOG_FLUSH_SEC=3
# Cắt bớt prompt/response trong log (ký tự)
LOG_MAX_CHARS=2000

# ===== Phân quyền =====
# SERVER_API_KEY ở trên có thể chứa nhiều key cho người dùng, cách nhau dấu phẩy: key1,key2
# Key quản trị (quản lý provider, xem log, thống kê). Trống = key người dùng cũng là quản trị
ADMIN_API_KEY=

# Giới hạn request/phút cho mỗi key (hoặc IP). 0 = không giới hạn. Admin không bị giới hạn
RATE_LIMIT_PER_MIN=30

# ===== Chat có lịch sử =====
# Số tin nhắn gần nhất được nhớ trong 1 cuộc trò chuyện
SESSION_MAX_MESSAGES=30
# Cuộc trò chuyện không dùng quá X giờ sẽ bị xóa
SESSION_TTL_HOURS=24
SESSION_FILE=./data/sessions.json

# ===== Giọng đọc (Gemini TTS) =====
# Dùng key của các dòng type=gemini trong sheet API
TTS_MODEL=gemini-3.8-flash-tts
TTS_MAX_CHARS=5000

# Tên tab chứa API key do server cấp
SHEET_KEYS_NAME=KEYS

# Địa chỉ lắng nghe: 0.0.0.0 (mọi nơi) hoặc 127.0.0.1 (chỉ trong máy, dùng khi có Caddy/Nginx phía trước)
HOST=0.0.0.0
